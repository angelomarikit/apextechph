# =============================================================================
# Apex Technology — environment variables
# Copy this file to .env.local and fill in values before connecting services.
# Never commit real credentials.
# =============================================================================

# Public site URL used for canonical links, sitemap, and Open Graph.
# Example: https://apextechnology.ph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
# The anon key is safe to expose in the browser. The service role key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for admin image uploads that bypass storage policies
# and for any privileged maintenance scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notification after a new inquiry.
# Leave blank until a provider is configured. The site will not claim email
# delivery is active while this is empty.
RESEND_API_KEY=
EMAIL_FROM=
# Receives contact & quote form submissions (default: marikitangelo@gmail.com)
INQUIRY_NOTIFY_EMAIL=marikitangelo@gmail.com

# Shown on Contact and footer (example: +63 912 345 6789)
NEXT_PUBLIC_CONTACT_PHONE=
